pipeline {

    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven 3.9'
    }

    parameters {
        string(
            name: 'NAME',
            defaultValue: 'DevOps User',
            description: 'Please tell me your name'
        )

        text(
            name: 'DESC',
            defaultValue: 'Pipeline CI/CD Jenkins GitHub',
            description: 'Description du Job'
        )

        booleanParam(
            name: 'SKIP_TEST',
            defaultValue: false,
            description: 'Skip running Tests ?'
        )

        choice(
            name: 'BRANCH',
            choices: ['main', 'dev', 'test'],
            description: 'Choose Git branch'
        )
    }

    environment {
        APP_NAME = "demo-app"
        DOCKER_IMAGE = "demo-app"
        APP_DIR = "demo-app"
    }

    stages {

        stage('01 - PRINT PARAMETERS') {
            steps {
                echo "Hello ${params.NAME}"

                echo """
                Job Description:
                ${params.DESC}
                """

                echo "Branch Selected : ${params.BRANCH}"
                echo "Skip Test : ${params.SKIP_TEST}"
            }
        }

        stage('02 - CHECKOUT GITHUB') {
            steps {
                echo "Downloading source code..."

                git branch: "${params.BRANCH}",
                    url: 'https://github.com/NicolasNicz/E5_tarbes_DevSecOps_juin_2026.git'
            }
        }

        stage('DEBUG JAVA') {
            steps {
                bat 'java -version'
                bat 'javac -version'
                bat 'where java'
            }
        }

        stage('03 - BUILD APPLICATION') {
            steps {
                echo "Building Application"

                dir("${APP_DIR}") {
                    bat """
                    echo Compilation en cours...
                    mvn clean package
                    """
                }
            }
        }

        stage('04 - RUN TESTS') {
            when {
                expression {
                    return params.SKIP_TEST == false
                }
            }

            steps {
                echo "Running Tests"

                dir("${APP_DIR}") {
                    bat """
                    mvn test
                    """
                }
            }
        }

        stage('05 - DOCKER BUILD') {
            steps {
                echo "Creating Docker image"

                dir("${APP_DIR}") {
                    bat """
                    docker build -t %DOCKER_IMAGE%:latest .
                    """
                }
            }
        }

        stage('06 - TRIVY IMAGE SCAN') {
            steps {
                echo "Scanning Docker image with Trivy"

                bat """
                trivy image ^
                --scanners vuln ^
                --timeout 15m ^
                --skip-version-check ^
                --severity HIGH,CRITICAL ^
                --exit-code 0 ^
                %DOCKER_IMAGE%:latest
                """
            }
        }

        stage('07 - DEPLOY') {
            steps {
                echo "Deploying Application"

                bat """
                docker stop %APP_NAME% || exit /b 0
                docker rm %APP_NAME% || exit /b 0
                docker run -d --name %APP_NAME% -p 8081:8080 %DOCKER_IMAGE%:latest
                """
            }
        }
    }

    post {
        success {
            echo """
            =========================
            PIPELINE SUCCESS
            Application deployed
            =========================
            """
        }

        failure {
            echo """
            =========================
            PIPELINE FAILED
            Please check logs
            =========================
            """
        }
    }
}